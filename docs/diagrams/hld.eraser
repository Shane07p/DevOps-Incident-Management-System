title Settle - High Level Design v4 (grey = not built yet)
direction right

Clients [icon: users] {
  Users [icon: users, label: "Users: On-Call, Commander, Scribe, Service Owner, Eng Manager, Admin, Auditor (app roles: Admin, Engineer, Viewer)"]
  WebApp [icon: react, label: "Settle web app (React)"]
  Customers [icon: globe, label: "Customers (public status page)", color: gray]
  AITools [icon: bot, label: "AI assistant (MCP client)", color: gray]
}

Signal Sources [icon: radar] {
  AlertTools [icon: bell-ring, label: "Monitoring tools and Grafana alert rules (/webhooks/alerts)"]
  UptimeRobot [icon: activity, label: "UptimeRobot (pings /actuator/health, keeps Render awake)"]
  DemoShop [icon: store, label: "Demo shop with fault switches"]
  CI [icon: github-actions, label: "GitHub Actions (deploy events)", color: gray]
  Jobs [icon: heart-pulse, label: "Scheduled jobs (heartbeat pings)", color: gray]
  Probes [icon: radar, label: "Probe agents in 2-3 regions", color: gray]
}

Edge [icon: shield] {
  Vercel [icon: vercel, label: "Vercel in production (HTTPS, serves the UI, rewrites /api to Render)"]
  Nginx [icon: server, label: "nginx, the Docker Compose entry point (serves the UI, proxies /api and /webhooks)"]
  Security [icon: lock, label: "Spring Security (JWT, tool tokens, personal access tokens; rate limits)"]
}

Backend on Render [icon: server] {
  Auth [icon: key-round, label: "Auth and users"]
  Monitoring [icon: activity, label: "Monitors and heartbeats", color: gray]
  Intake [icon: inbox, label: "Alert intake (validate, dedup, group)"]
  Incident [icon: siren, label: "Incident service (lifecycle, SLA clocks, roles)", color: orange]
  Catalog [icon: calendar-clock, label: "Catalog and on-call (services, schedules, service map, runbooks)"]
  Timeline [icon: scroll-text, label: "Timeline and audit (append-only)"]
  Notify [icon: bell, label: "In-app notifications (saved with the change)"]
  Escalation [icon: alarm-clock, label: "Escalation worker (polls every 1 min)"]
  Relay [icon: repeat, label: "Outbox relay (publishes once committed)"]
  Live [icon: radio, label: "Live updates (refresh every few seconds, then server-sent events)", color: gray]
  Deploys [icon: rocket, label: "Deploy tracking", color: gray]
  StatusSvc [icon: globe, label: "Status page", color: gray]
  Reporting [icon: bar-chart-3, label: "Postmortems, insights, and search", color: gray]
  Telemetry [icon: line-chart, label: "Logs and metrics queries (server-side token)", color: gray]
}

Database [icon: database] {
  Postgres [icon: postgresql, label: "PostgreSQL on Supabase (schema incident)"]
  Outbox [icon: archive, label: "outbox table (same transaction as the change)"]
}

RabbitMQ on CloudAMQP [icon: rabbitmq] {
  Exchange [icon: rabbitmq, label: "settle.events (topic exchange)"]
  QEmail [icon: list, label: "email queue", color: gray]
  QAI [icon: list, label: "ai-jobs queue (later)", color: gray]
  DLQ [icon: trash-2, label: "failed messages (DLQ)", color: gray]
}

Backend workers [icon: cpu] {
  EmailWorker [icon: send, label: "Email worker (retries)", color: gray]
  AIWorker [icon: bot, label: "AI job worker (later)", color: gray]
}

AI Service [icon: python] {
  AIFeatures [icon: sparkles, label: "AI features: find similar, AI SRE, drafting, triage hint (suggest only; Docker Compose, not on Render)"]
  MCPServer [icon: plug, label: "MCP server (calls the REST API as the user)", color: gray]
}

Models [icon: brain] {
  Ollama [icon: brain, label: "Ollama: LLM and embeddings (default)"]
  Hosted [icon: cloud, label: "Hosted LLM (optional, off by default)", color: gray]
}

Grafana Cloud [icon: grafana] {
  Prometheus [icon: prometheus, label: "Prometheus (metrics)"]
  Loki [icon: file-text, label: "Loki (logs)"]
}

External [icon: plug] {
  EmailProvider [icon: mail, label: "Email provider (to be chosen, D47)", color: gray]
}

Users > WebApp
WebApp > Vercel
WebApp > Nginx
Customers > Vercel
AITools > MCPServer: personal access token
Vercel > Security
Nginx > Security
Signal Sources > Security: webhooks, check results, heartbeats, health pings
Security > Backend on Render

Monitoring > Intake
Intake > Incident
Incident > Catalog
Incident > Timeline
Incident > Notify
Escalation > Notify
Deploys > Timeline: deploys in the window
Incident --> StatusSvc

Backend on Render > Postgres
Incident > Outbox
Escalation > Outbox
Relay > Outbox
Relay > Exchange

Exchange --> QEmail
Exchange --> QAI
QEmail --> EmailWorker
QAI --> AIWorker
QEmail --> DLQ
QAI --> DLQ
EmailWorker --> EmailProvider

Incident --> AIFeatures: find similar, triage hint
AIWorker --> AIFeatures
AIFeatures > MCPServer
AIFeatures > Ollama
AIFeatures --> Hosted

Telemetry > Grafana Cloud: PromQL and LogQL
DemoShop > Grafana Cloud
