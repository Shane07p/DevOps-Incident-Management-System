# Normalise line endings so a ten-person team does not trade CRLF-only diffs.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
mvnw text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary

# The taste-skill kit the landing page loads (#267): third-party files, copied as they are, never edited.
# GitHub collapses them in diffs and leaves them out of the language stats.
frontend/public/landing/assets/** linguist-generated=true linguist-vendored=true
