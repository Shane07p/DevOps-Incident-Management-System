# Demo Shop environment configuration
PORT=8001
HOST=0.0.0.0
SERVICE_NAME=demo-shop
ENVIRONMENT=development
# Set a private control token before exposing the shop; required in production.
DEMO_SHOP_CONTROL_TOKEN=
LOG_LEVEL=INFO

# Deployment tracking webhook settings (FR-20.1, Issue #152)
# Base URL of the incident backend API (default: http://localhost:8080)
BACKEND_URL=http://localhost:8080
# Bearer token of a registered monitoring tool created on the Tools page (starts with tt_)
TOOL_TOKEN=
# Service name in the incident catalog to attribute the deploy to (default: checkout)
DEPLOY_SERVICE_NAME=checkout

# OpenTelemetry / Grafana Cloud settings (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
