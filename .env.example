# Copy to .env and adjust locally. Never commit the real .env.

# Database
# 5433, not 5432: a locally installed PostgreSQL service commonly owns 5432 and would
# shadow the container. Change it only if 5433 is taken too.
DB_NAME=incident
DB_USERNAME=incident
DB_PASSWORD=change-me-locally
DB_PORT=5433

# Backend
APP_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/incident
# Connection pool (D43). The defaults suit local work; on Render, keep DB_POOL_SIZE below the
# Supabase session pooler's limit. Leak detection logs a connection held longer than this (ms).
# DB_POOL_SIZE=10
# DB_POOL_CONNECTION_TIMEOUT_MS=30000
# DB_POOL_MAX_LIFETIME_MS=1800000
# DB_POOL_LEAK_DETECTION_MS=20000

# UI through nginx in `docker compose --profile app` (D41)
WEB_PORT=8081
# Signs login tokens. Generate with: openssl rand -base64 32
# Left empty, the backend uses a random key and tokens stop working on every restart.
JWT_SECRET=

# Dev seed data (D27): users admin, engineer, viewer (password DevPassw0rd!) and a Payments service.
# Off by default. Uncomment to load it in `docker compose --profile app`; ./mvnw does not read this
# file. Turning it off later keeps the seed's rows in the database; see the README.
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/devdata

# Rate limits (D42). The defaults match the decision; set these on Render only to change them.
# RATE_LIMIT_LOGIN_CAPACITY=5
# RATE_LIMIT_LOGIN_DURATION=60s
# RATE_LIMIT_WEBHOOK_CAPACITY=50
# RATE_LIMIT_WEBHOOK_DURATION=1s
# RATE_LIMIT_MAX_BUCKETS=10000
# Login limits need each caller's own address. Tomcat reads it from X-Forwarded-For only when the
# connection comes from a trusted proxy, by default any private address (nginx in Compose, a cloud
# load balancer). If logs on Render show one address for every caller, set this regex to the proxy's.
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=10\.\d{1,3}\.\d{1,3}\.\d{1,3}

# Shared secret the alert source signs its requests with (FR-03.1).
# Generate a random value per environment; this placeholder is not a usable secret.
ALERT_SOURCE_SECRET=replace-with-a-random-value

# AI service (optional local container)
AI_PORT=8000

# Ollama local LLM runner (optional)
# For local host runs: http://localhost:11434
# For docker-compose runs: http://ollama:11434 (leave commented so Compose default applies)
OLLAMA_PORT=11434
# OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=10

# Demo Shop v1 (optional local container, Issue #76)
DEMO_SHOP_PORT=8001
# OpenTelemetry / Grafana Cloud settings (D34, #75)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-base64-token
