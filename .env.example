# Copy to .env and adjust locally. Never commit the real .env.

# Database
# 5433, not 5432: a locally installed PostgreSQL service commonly owns 5432 and would
# shadow the container. Change it only if 5433 is taken too.
DB_NAME=incident
DB_USERNAME=incident
DB_PASSWORD=change-me-locally
DB_PORT=5433

# Backend
APP_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/incident
# Connection pool (D43). The defaults suit local work; on Render, keep DB_POOL_SIZE below the
# Supabase session pooler's limit. Leak detection logs a connection held longer than this (ms).
# DB_POOL_SIZE=10
# DB_POOL_CONNECTION_TIMEOUT_MS=30000
# DB_POOL_MAX_LIFETIME_MS=1800000
# DB_POOL_LEAK_DETECTION_MS=20000

# UI through nginx in `docker compose --profile app` (D41)
WEB_PORT=8081
# Signs login tokens. Generate with: openssl rand -base64 32
# Left empty, the backend uses a random key and tokens stop working on every restart.
JWT_SECRET=

# Dev seed data (D27): users admin, engineer, viewer (password DevPassw0rd!) and a Payments service.
# Off by default. Uncomment to load it in `docker compose --profile app`; ./mvnw does not read this
# file. Turning it off later keeps the seed's rows in the database; see the README.
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/devdata

# Rate limits (D42). The defaults match the decision; set these on Render only to change them.
# RATE_LIMIT_LOGIN_CAPACITY=5
# RATE_LIMIT_LOGIN_DURATION=60s
# RATE_LIMIT_WEBHOOK_CAPACITY=50
# RATE_LIMIT_WEBHOOK_DURATION=1s
# RATE_LIMIT_MAX_BUCKETS=10000
# Login limits need each caller's own address. Tomcat reads it from X-Forwarded-For only when the
# connection comes from a trusted proxy, by default any private address (nginx in Compose, a cloud
# load balancer). If logs on Render show one address for every caller, set this regex to the proxy's.
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=10\.\d{1,3}\.\d{1,3}\.\d{1,3}

# Alert senders need no shared secret: each tool gets its own token on the Tools page (D31).

# RabbitMQ (D24, #82). Unset, events wait in the outbox and nothing connects to RabbitMQ. Production:
# the AMQP URL of the hosted instance, set on Render. Locally, `docker compose --profile queue up -d`
# and amqp://settle:<RABBITMQ_PASSWORD>@localhost:5672 (or @rabbitmq:5672 for the app container).
# RABBITMQ_URL=
RABBITMQ_USER=settle
RABBITMQ_PASSWORD=change-me-locally
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
# How often the outbox is checked, in milliseconds.
# OUTBOX_RELAY_DELAY_MS=5000

# Uptime monitors refuse private and local addresses (localhost, 10.x, 169.254.169.254). Set to true
# only to point a local monitor at the demo shop on localhost; never on Render.
# MONITORS_ALLOW_PRIVATE_TARGETS=false
# MONITORS_WORKER_DELAY_MS=10000

# AI service (optional local container)
AI_PORT=8000
# Optional backend-to-AI connection. For a host-run backend use localhost; for Compose use the service name.
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_TIMEOUT=5s

# Settle MCP Server (Sprint 4, Issue #162)
# Standalone FastMCP server running on port 8001 for AI assistants (Cursor, Claude Code, etc.)
# MCP_PORT=8001
SETTLE_API_URL=http://localhost:8080
SETTLE_API_TIMEOUT=10

# Autonomous AI SRE agent settings (Issue #91)
AGENT_MODEL=qwen2.5:0.5b
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_SECONDS=15.0
AGENT_MAX_TOKENS=4000

# Ollama local LLM runner (optional)
# For local host runs: http://localhost:11434
# For docker-compose runs: http://ollama:11434 (leave commented so Compose default applies)
OLLAMA_PORT=11434
# OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=10

# Demo Shop v1 (optional local container, Issue #76)
DEMO_SHOP_PORT=8001
# Set a private control token before exposing the shop; required when ENVIRONMENT=production.
DEMO_SHOP_CONTROL_TOKEN=
# Deployment tracking webhook (FR-20.1, Issue #152)
# When the bad_deploy fault switch is activated, Demo Shop posts a deployment event to the backend.
# BACKEND_URL: Base URL of the incident backend API (default: http://localhost:8080)
# BACKEND_URL=http://localhost:8080
# TOOL_TOKEN: Bearer token of a registered monitoring tool created on the Tools page (starts with tt_)
# TOOL_TOKEN=
# DEPLOY_SERVICE_NAME: Service name in the incident catalog to attribute the deploy to (default: checkout)
# DEPLOY_SERVICE_NAME=checkout
# Grafana Cloud (D34, #75). Two access-policy tokens, never committed:
# a write token (metrics, logs, traces) for the demo shop, and a read token (metrics, logs) for the backend.
# Demo shop, through OTLP: the endpoint and instance ID are on the stack's OpenTelemetry page;
# the header is Basic base64("<instance id>:<write token>").
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-base64-token
# Backend reads: each organization connects its own Grafana in Settings (D49, #260), so the Prometheus
# and Loki URLs, user IDs, and read token are saved per org, not here. The server only needs the key
# that encrypts those tokens: 32 random bytes, base64. Generate one with `openssl rand -base64 32`,
# set it on Render, and keep it: changing it makes every saved token unreadable until saved again.
# TELEMETRY_SECRET_KEY=replace-with-base64-of-32-random-bytes
# Seconds the backend waits for Loki or Prometheus before answering 503 (default 5).
# TELEMETRY_TIMEOUT_SECONDS=5
# Local runs only: lets an org point at a Grafana on a private address or plain http. Never on Render.
# TELEMETRY_ALLOW_PRIVATE_TARGETS=false
