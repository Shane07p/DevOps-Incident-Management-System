# Copy to .env and adjust locally. Never commit the real .env.

# Database
# 5433, not 5432: a locally installed PostgreSQL service commonly owns 5432 and would
# shadow the container. Change it only if 5433 is taken too.
DB_NAME=incident
DB_USERNAME=incident
DB_PASSWORD=change-me-locally
DB_PORT=5433

# Backend
APP_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/incident

# Shared secret the alert source signs its requests with (FR-03.1).
# Generate a random value per environment; this placeholder is not a usable secret.
ALERT_SOURCE_SECRET=replace-with-a-random-value

# AI service (optional).
# Leave AI_SERVICE_URL unset (or empty) to run without AI – the backend will
# skip all AI calls and the frontend hides the AI panels (FR-18.4).
AI_PORT=8000
# AI_SERVICE_URL=http://localhost:8000
